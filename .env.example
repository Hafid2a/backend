# Production / Easypanel template. For local Docker, copy env.local.example to .env instead (avoids empty DB_PASSWORD errors).
APP_ENV=production
API_BASE_URL=https://api.najdofficial.com
FRONTEND_BASE_URL=https://najdofficial.com

# Paste the Postgres password generated for user "najd" here (Easypanel DB service).
# The app substitutes ${DB_PASSWORD} into DATABASE_URL at startup (Compose-style ${} is not expanded by pydantic/dotenv).
# Alternatively set DATABASE_URL to the full URL (password URL-encoded if it has special characters) and omit DB_PASSWORD.
DATABASE_URL=postgresql+asyncpg://najd:${DB_PASSWORD}@najd_database:5432/najd
DB_PASSWORD=

CORS_ORIGINS=https://najdofficial.com,https://www.najdofficial.com,http://localhost:3000

ADMIN_USERNAME=
ADMIN_PASSWORD=

SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=
SNAP_TEST_EVENT_CODE=

LOG_LEVEL=INFO

# MaxMind GeoIP Insights API (https://dev.maxmind.com/geoip/docs/web-services)
# Account ID = numeric ID from MaxMind account · License Key = generate under "My License Key"
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Reject when traits.ip_risk_snapshot is present and >= this (1–99).
MAXMIND_IP_RISK_THRESHOLD=50
# Block datacenter/hosting IPs (catches many VPNs; set false if you see false positives).
MAXMIND_BLOCK_HOSTING_PROVIDER=true
# If true, allow orders when MaxMind HTTP/request fails (default: false = block / 503).
MAXMIND_FAIL_OPEN=false
# Optional secondary VPN/proxy provider. Use {ip} in the URL where the client IP should be inserted.
SECONDARY_VPN_CHECK_URL=
SECONDARY_VPN_CHECK_API_KEY=
SECONDARY_VPN_FAIL_OPEN=false
SECONDARY_VPN_RISK_THRESHOLD=50
# true = تجاوز MaxMind لجميع الطلبات (أي رقم من أي بلد). خطر احتيال — للاختبار/ليدات فقط.
SKIP_ORDER_GEO_CHECK=false
# 0550505044 مدمج في الكود كتجاوز؛ سطر إضافي لأرقام أخرى. is_test_order = بدون Sheet/CAPI للأرقام المدرجة.
GEO_ORDER_BYPASS_PHONES=0550505044
