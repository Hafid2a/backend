APP_ENV=production
API_BASE_URL=https://api.najdofficial.com
FRONTEND_BASE_URL=https://najdofficial.com

# Paste the Postgres password generated for user "najd" here (Easypanel DB service).
# The app substitutes ${DB_PASSWORD} into DATABASE_URL at startup (Compose-style ${} is not expanded by pydantic/dotenv).
# Alternatively set DATABASE_URL to the full URL (password URL-encoded if it has special characters) and omit DB_PASSWORD.
DATABASE_URL=postgresql+asyncpg://najd:${DB_PASSWORD}@najd_database:5432/najd
DB_PASSWORD=

CORS_ORIGINS=https://najdofficial.com

SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=
SNAP_TEST_EVENT_CODE=

LOG_LEVEL=INFO

# MaxMind GeoIP Insights — https://www.maxmind.com/en/geoip-api-web-services
# Leave empty in local dev to skip IP checks. Set both in production.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Reject when traits.ip_risk_snapshot >= this (only when MaxMind returns a score).
MAXMIND_IP_RISK_THRESHOLD=50
# If true, allow orders when MaxMind is unreachable (default: false = block).
MAXMIND_FAIL_OPEN=false
# Test / ops phones that skip geo + VPN checks (comma-separated). Example: 643281895 → +9665643281895
GEO_ORDER_BYPASS_PHONES=643281895
